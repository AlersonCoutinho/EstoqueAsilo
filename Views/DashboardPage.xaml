<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:EstoqueAsilo"
             x:Class="EstoqueAsilo.DashboardPage"
             Title="DashboardPage"
             Shell.NavBarIsVisible="False">
    <Grid ColumnDefinitions="200, *">
        <local:MenuLateral x:Name="MenuLateralControl" Grid.Column="0"/>
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <local:BarraSuperior Grid.Row="0"/>
            <ContentView Grid.Row="1" Content="{Binding ConteudoAtual}" />
        </Grid>
        <Grid IsVisible="{Binding Carregando}" BackgroundColor="#D0FFFFFF" Grid.Column="1">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding Carregando}" WidthRequest="48" HeightRequest="48" />
                <Label Text="Carregando..." TextColor="Black" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>