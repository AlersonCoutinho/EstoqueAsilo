<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EstoqueAsilo.Models.Resultados"
             x:Class="EstoqueAsilo.EntradaView"
             BackgroundColor="#F2F2F2">
    
    <Grid RowDefinitions="auto, *"  Padding="30,20" RowSpacing="10">
        <Label Grid.Row="0" Text="Registrar Entrada" FontSize="24" TextColor="Black" />
        <Grid Grid.Row="1" ColumnDefinitions="2*, *" ColumnSpacing="20" RowDefinitions="*">
            <ScrollView Grid.Column="0" VerticalScrollBarVisibility="Always">
                <Border BackgroundColor="White" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 3" Padding="15" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Últimas entradas" FontSize="18" TextColor="Black"/>
                        <Grid ColumnDefinitions="100,2*,90,100" RowDefinitions="Auto, *" RowSpacing="8" ColumnSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0" Text="Data" TextColor="Black" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Item" TextColor="Black" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="2" Text="Qtd" TextColor="Black" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="3" Text="Origem" TextColor="Black" FontAttributes="Bold" />

                            <CollectionView Grid.Row="1" Grid.ColumnSpan="4" ItemsSource="{Binding Entradas}" SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.EmptyView>
                                    <Label Text="Nenhuma entrada registrada." HorizontalOptions="Center" Margin="0,30" />
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:EntradaLinha">
                                        <Border StrokeThickness="0" Padding="12,10" BackgroundColor="#F4F5F7" StrokeShape="RoundRectangle 10">
                                            <Grid ColumnSpacing="10" ColumnDefinitions="100,2*,90,100">
                                                <Label Grid.Column="0" VerticalOptions="Center" Text="{Binding Data, StringFormat='{0:dd/MM/yyyy}'}" />
                                                <Label Grid.Column="1" VerticalOptions="Center" FontAttributes="Bold" LineBreakMode="TailTruncation" Text="{Binding Item}" />
                                                <Label Grid.Column="2" VerticalOptions="Center" Text="{Binding Quantidade}" />
                                                <Label Grid.Column="3" Text="{Binding Origem}" FontSize="12" TextColor="#222222" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
            <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Always">
                <Border BackgroundColor="White" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 3" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Nova entrada" FontSize="18" TextColor="Black"/>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Categoria" TextColor="Black" FontSize="12"/>
                            <Picker ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSelecionada}" TextColor="Black" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Item" TextColor="Black" FontSize="12" />
                            <Entry Placeholder="Ex: Café" TextColor="Black" Text="{Binding NomeProduto}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Quantidade e Unidade" TextColor="Black" FontSize="12" />
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <Entry Grid.Column="0" Placeholder="Ex: 20" Keyboard="Numeric" TextColor="Black" Text="{Binding Quantidade}"/>
                                <Picker Grid.Column="1" ItemsSource="{Binding Unidades}" SelectedItem="{Binding UnidadeSelecionada}" TextColor="Black"/>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5" IsVisible="{Binding MostrarValidade}">
                            <Label Text="Validade" TextColor="Black" FontSize="12" />
                            <DatePicker Date="{Binding DataValidade}" Format="dd/MM/yyyy" TextColor="Black" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="auto, *, 50">
                            <Label Grid.Column="0" Text="É doação?" TextColor="Black" FontSize="12" VerticalOptions="Center" />
                            <Switch Grid.Column="2" IsToggled="{Binding EhDoacao}" />
                        </Grid>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding TipoOrigem}" TextColor="Black" FontSize="12"/>
                            <Entry Placeholder="Ex: Escola Municipal" TextColor="Black" Text="{Binding Origem}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5" IsVisible="{Binding NaoEhDoacao}">
                            <Label Text="Preço Unitário (R$)" TextColor="Black" FontSize="12"/>
                            <Entry Placeholder="Ex: 5.50" Keyboard="Numeric" TextColor="Black" Text="{Binding Preco}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5" IsVisible="{Binding NaoEhDoacao}">
                            <Label Text="Nota Fiscal" TextColor="Black" FontSize="12"/>
                            <Entry Placeholder="Ex: NF-12345" TextColor="Black" Text="{Binding NotaFiscal}"/>
                        </VerticalStackLayout>

                        <Border BackgroundColor="#2E8B57" StrokeThickness="0" StrokeShape="RoundRectangle 3" Padding="15,12" Margin="0,10,0,0">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#2E8B57" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#1E5C39" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RegEntradaCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="entrada.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                                <Label Text="Registrar entrada" TextColor="White" FontSize="15" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>
    </Grid>
</ContentView>
