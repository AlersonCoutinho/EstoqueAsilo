<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstoqueAsilo.EntradaView"
             BackgroundColor="#F2F2F2">
    <ScrollView>
    <VerticalStackLayout Padding="30,20" Spacing="10">
        <Label Text="Registrar Entrada" FontSize="24" TextColor="Black" />
        <Grid ColumnDefinitions="2*, *" ColumnSpacing="20">
                <Border BackgroundColor="White" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="15" VerticalOptions="Start">
                <VerticalStackLayout Grid.Column="0" Spacing="10">
                    <Label Text="Últimas entradas" FontSize="18" TextColor="Black"/>
                    <Grid ColumnDefinitions="Auto, 2*, Auto, 2*, 2*" RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="8" ColumnSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Data" TextColor="Black" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Item" TextColor="Black" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="2" Text="Qtd" TextColor="Black" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="3" Text="Origem / motivo" TextColor="Black" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="4" Text="Detalhe" TextColor="Black" FontAttributes="Bold" />

                        <Label Grid.Row="1" Grid.Column="0" Text="11/10/2026" TextColor="Black" />
                        <Label Grid.Row="1" Grid.Column="1" Text="Fralda G" TextColor="Black" />
                        <Label Grid.Row="1" Grid.Column="2" Text="500" TextColor="Black" />
                        <Label Grid.Row="1" Grid.Column="3" Text="Doação" TextColor="Black" />
                        <Label Grid.Row="1" Grid.Column="4" Text="Campanha das fraldas" TextColor="Black" />

                        <Label Grid.Row="2" Grid.Column="0" Text="09/10/2026" TextColor="Black" />
                        <Label Grid.Row="2" Grid.Column="1" Text="Arroz 5 kg" TextColor="Black" />
                        <Label Grid.Row="2" Grid.Column="2" Text="30" TextColor="Black" />
                        <Label Grid.Row="2" Grid.Column="3" Text="Compra" TextColor="Black" />
                        <Label Grid.Row="2" Grid.Column="4" Text="Mercado Silva" TextColor="Black" />

                        <Label Grid.Row="3" Grid.Column="0" Text="07/10/2026 " TextColor="Black" />
                        <Label Grid.Row="3" Grid.Column="1" Text="Leite UHT 1 L" TextColor="Black" />
                        <Label Grid.Row="3" Grid.Column="2" Text="24" TextColor="Black" />
                        <Label Grid.Row="3" Grid.Column="3" Text="Doação" TextColor="Black" />
                        <Label Grid.Row="3" Grid.Column="4" Text="Escola Municipal" TextColor="Black" />

                        <Label Grid.Row="4" Grid.Column="0" Text="06/10/2026" TextColor="Black" />
                        <Label Grid.Row="4" Grid.Column="1" Text="Detergente" TextColor="Black" />
                        <Label Grid.Row="4" Grid.Column="2" Text="20" TextColor="Black" />
                        <Label Grid.Row="4" Grid.Column="3" Text="Compra" TextColor="Black" />
                        <Label Grid.Row="4" Grid.Column="4" Text="Atacado" TextColor="Black" />

                    </Grid>
                </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="White" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundREctangle 8" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Nova entrada" FontSize="18" TextColor="Black"/>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Item" TextColor="Black" FontSize="12" />
                            <Entry x:Name="ItemEntry" Placeholder="Ex: Café" TextColor="Black" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Quantidade" TextColor="Black" FontSize="12" />
                            <Entry x:Name="QuantidadeEntry" Placeholder="Ex: 20" Keyboard="Numeric" TextColor="Black" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Origem" TextColor="Black" FontSize="12" />
                            <Entry x:Name="OrigemEntry" Placeholder="Ex: Escola" TextColor="Black" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Doador / fornecedor / nota fiscal" TextColor="Black" FontSize="12" />
                            <Entry x:Name="DoadorEntry" Placeholder="Ex: Nome" TextColor="Black" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Validade (alimentos)" TextColor="Black" FontSize="12" />
                            <Entry x:Name="ValidadeEntry" Placeholder="dd/mm/aaaa" TextColor="Black" />
                        </VerticalStackLayout>

                        <Button x:Name="RegistrarButton"
                                Text="Registrar entrada"
                                BackgroundColor="#2E8B57"
                                TextColor="White"
                                CornerRadius="8"
                                Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Border>
        </Grid>
    </VerticalStackLayout>
    </ScrollView>
</ContentView>
