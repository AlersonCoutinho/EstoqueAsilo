<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstoqueAsilo.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="*, *" RowSpacing="15">

        <BoxView     Grid.RowSpan="3"
                     Grid.Column="0"
                     Color="#0082db" >
        </BoxView>
        <BoxView     Grid.RowSpan="3"
                     Grid.Column="1"
                     Color="White" >
        </BoxView>

        <Image  Grid.Column="0"
                x:Name="ImagemLogo"
                Source="logo_brasil_sem_fundo.png"
                Aspect="AspectFit"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="100,100,100,100">
        </Image>

        <VerticalStackLayout Grid.Column="1" Padding="30" Spacing="15" VerticalOptions="Center">

            <Label
            Text="Bem-vindo ao Asilo São Vicente!"
            FontSize="32"
            FontAttributes="Bold"
            HorizontalOptions="Center" 
            TextColor="black"/>

            <Label
            Text="Digite seu email"
            FontSize="14" 
            TextColor="black"/>

            <Entry
            x:Name="Caixa1"
            Text="{Binding Email}"
            Placeholder="E-mail"
            Keyboard="Email"
            ClearButtonVisibility="WhileEditing"
            MaxLength="100"
            TextColor="black"
            BackgroundColor="#F0F0F0"/>

            <Label
            Text="Digite a senha"
            FontSize="14"
            TextColor="black"/>
            
            <Entry
            x:Name="Caixa2"
            Text="{Binding Senha}"
            Placeholder="Senha"
            IsPassword="True"
            MaxLength="50"
            TextColor="black"
            BackgroundColor="#F0F0F0"/>
            
            <Button
            x:Name="EntrarButton"
            Text="Entrar"
            Command="{Binding EntrarCommand}"
            TextColor="White"
            BackgroundColor="#0A6FB5"/>

            <Label 
            Text="{Binding MensagemErro}"
            IsVisible="{Binding TemErro}"
            TextColor="Red"
            FontSize="13"
            HorizontalOptions="Center" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>