<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstoqueAsilo.Views.Components.ComboEditavel"
             x:Name="root">

    <VerticalStackLayout Spacing="2">
        <Grid ColumnDefinitions="*">
            <Entry x:Name="CampoEntry"
                Text="{Binding Text, Source={x:Reference root}}"
                Placeholder="{Binding Placeholder, Source={x:Reference root}}"
                TextColor="Black"
                TextChanged="OnTextChanged"
                Focused="OnFocused"
                Unfocused="OnUnfocused"/>
            <Button Text="▾" Clicked="OnSetaClicked" FontSize="30"
                BackgroundColor="Transparent" TextColor="#0A6FB5"
                Padding="0" WidthRequest="36" HorizontalOptions="End"/>
        </Grid>

        <Border x:Name="Lista" IsVisible="False" Stroke="LightGray" StrokeThickness="1"
                StrokeShape="RoundRectangle 3" BackgroundColor="White">
            <CollectionView x:Name="Sugestoes" MaximumHeightRequest="160"
                            SelectionMode="Single" SelectionChanged="OnSelecionado">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" TextColor="Black" Padding="10,8" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </VerticalStackLayout>
</ContentView>