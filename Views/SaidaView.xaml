<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:EstoqueAsilo.Views.Components"
             xmlns:conv="clr-namespace:EstoqueAsilo.Converters"
             xmlns:models="clr-namespace:EstoqueAsilo.Models.Resultados"
             x:Class="EstoqueAsilo.SaidaView"
             BackgroundColor="#F2F2F2">

    <ContentView.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColor" CorVerdadeiro="#E53935"  CorFalso="#2E8B57"/>
    </ContentView.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="10">
            <Label Text="Registrar Saída" FontSize="24" TextColor="Black" />
            <Grid ColumnDefinitions="2*, *" ColumnSpacing="20">
                <Border BackgroundColor="White" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="15" VerticalOptions="Start">
                    <VerticalStackLayout Grid.Column="0" Spacing="10">
                        <Label Text="Últimas Saídas" FontSize="18" TextColor="Black"/>
                        <Grid ColumnDefinitions="100,*,90,100" RowDefinitions="Auto, *" RowSpacing="8" ColumnSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0" Text="Data" TextColor="Black" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Item" TextColor="Black" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="2" Text="Qtd" TextColor="Black" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="3" Text="Destino" TextColor="Black" FontAttributes="Bold" />

                            <CollectionView Grid.Row="1" Grid.ColumnSpan="4" ItemsSource="{Binding Saidas}" SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.EmptyView>
                                    <Label Text="Nenhuma saída registrada." HorizontalOptions="Center" Margin="0,30" />
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:MovimentacaoLinha">
                                        <Border StrokeThickness="0" Padding="12,10" BackgroundColor="#F4F5F7" StrokeShape="RoundRectangle 10">
                                            <Grid ColumnSpacing="10" ColumnDefinitions="100,2*,90,100">
                                                <Label Grid.Column="0" VerticalOptions="Center" Text="{Binding Data, StringFormat='{0:dd/MM/yyyy}'}" />
                                                <Label Grid.Column="1" VerticalOptions="Center" FontAttributes="Bold" LineBreakMode="TailTruncation" Text="{Binding Item}" />
                                                <Label Grid.Column="2" VerticalOptions="Center" Text="{Binding Quantidade}" />
                                                <Label Grid.Column="3" Text="{Binding Contraparte}" FontSize="12" TextColor="#222222" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="White" Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundREctangle 8" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Nova Saída" FontSize="18" TextColor="Black"/>

                        <Grid ColumnDefinitions="2*, *" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Item" TextColor="Black" FontSize="12" />
                                <Picker ItemsSource="{Binding Produtos}" SelectedItem="{Binding ProdutoSelecionado}" 
                                        TextColor="Black" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Unidade" TextColor="Black" FontSize="12" />
                                <Picker ItemsSource="{Binding Unidades}" SelectedItem="{Binding UnidadeSelecionada}" 
                                        TextColor="Black" IsEnabled="{Binding UnidadeIsEnabled}" />
                            </VerticalStackLayout>
                        </Grid>
                        
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Quantidade" TextColor="Black" FontSize="12" />
                            <Entry Text="{Binding Quantidade}" Placeholder="Ex: 20" Keyboard="Numeric" TextColor="Black" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="auto, *, 50">
                            <Label Grid.Column="0" Text="É doação?" TextColor="Black" FontSize="12" VerticalOptions="Center" />
                            <Switch Grid.Column="2" IsToggled="{Binding EhDoacao}" />
                        </Grid>

                        <VerticalStackLayout Spacing="5" IsVisible="{Binding EhDoacao}">
                            <Label Text="Instituição de destino" TextColor="Black" FontSize="12" />
                            <Entry Text="{Binding Instituicao}" Placeholder="Ex: Centro de ajuda" TextColor="Black" />
                        </VerticalStackLayout>

                        <Border BackgroundColor="{Binding TemErro, Converter={StaticResource BoolToColor}}"
                            IsVisible="{Binding MostrarMensagem}" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                                Padding="8"  Opacity="0.9">
                            <Label 
                            Text="{Binding Mensagem}"
                            TextColor="White"
                            FontSize="14"
                            FontAttributes="Bold"
                            HorizontalOptions="Center" />
                        </Border>

                        <Button Command="{Binding RegSaidaCommand}"
                                Text="Registrar saída"
                                BackgroundColor="#0A6FB5"
                                TextColor="White"
                                CornerRadius="8"
                                Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
