<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:EstoqueAsilo.Views.Components"
             x:Class="EstoqueAsilo.LoginView"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="*, *" RowSpacing="15">

        <BoxView     Grid.RowSpan="3"
                     Grid.Column="0"
                     Color="{StaticResource Primary}" >
        </BoxView>
        <BoxView     Grid.RowSpan="3"
                     Grid.Column="1"
                     Color="White" >
        </BoxView>

        <Border StrokeShape="Ellipse" StrokeThickness="0" BackgroundColor="White"
            Padding="12" HeightRequest="400" WidthRequest="400">
            <Image  Source="logo_brasil_sem_fundo.png"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
            </Image>
        </Border>
        <VerticalStackLayout Grid.Column="1" Padding="30" Spacing="15" VerticalOptions="Center">

            <Label
            Text="Bem-vindo ao Asilo São Vicente!"
            FontSize="32"
            FontAttributes="Bold"
            HorizontalOptions="Center" 
            TextColor="black"/>

            <Label
            Text="Digite seu usuário:"
            FontSize="14" 
            TextColor="black"/>

            <comp:ComboEditavel ItemsSource="{Binding Usuarios}"
                Text="{Binding Usuario}"
                Placeholder="Usuario" />

            <Label
            Text="Digite a senha:"
            FontSize="14"
            TextColor="black"/>
            
            <Entry
            x:Name="CaixaSenha"
            Text="{Binding Senha}"
            Placeholder="Senha"
            IsPassword="True"
            ReturnType="Go" 
            ReturnCommand="{Binding EntrarCommand}"
            MaxLength="50"
            TextColor="black"
            BackgroundColor="#F0F0F0"/>

            <Button
            x:Name="EntrarButton"
            Text="Entrar"
            Command="{Binding EntrarCommand}"
            TextColor="White"
            BackgroundColor="#0A6FB5"/>

            <Button
            Text="Acessar xmls [DEBUG]"
            Command="{Binding DebugCommand}"
            TextColor="White"
            BackgroundColor="Red"/>

            <Label 
            Text="{Binding MensagemErro}"
            IsVisible="{Binding TemErro}"
            TextColor="Red"
            FontSize="13"
            HorizontalOptions="Center" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>