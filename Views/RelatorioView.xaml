<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstoqueAsilo.RelatorioView"
             BackgroundColor="#F2F2F2">
    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="20">
            <Label Text="Relatórios" FontSize="24" TextColor="Black" />
            <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                <Border Grid.Column="0" BackgroundColor="White" Stroke="LightGray" StrokeShape="RoundRectangle 3" Padding="20">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Consumo por item (uso interno)" FontAttributes="Bold" TextColor="Black" FontSize="16"/>
                        <Label Text="Base para a média mensal, inclusive por tamanho de fralda." FontSize="11" TextColor="Gray" Margin="0,0,0,15"/>

                        <CollectionView ItemsSource="{Binding ConsumoInterno}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="120, *, Auto" ColumnSpacing="10" Margin="0,2">
                                        <Label Grid.Column="0" Text="{Binding Nome}" TextColor="Black" VerticalOptions="Center" FontSize="13"/>
                                        <ProgressBar Grid.Column="1" Progress="{Binding PorcentagemBarra}" ProgressColor="#0A6FB5" VerticalOptions="Center"/>
                                        <Label Grid.Column="2" Text="{Binding Valor}" TextColor="Black" VerticalOptions="Center" FontSize="13" FontAttributes="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="White" Stroke="LightGray" StrokeShape="RoundRectangle 3" Padding="20">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Compra x doação (entradas)" FontAttributes="Bold" TextColor="Black" FontSize="16"/>
                        <Label Text="De onde vem o que entra no estoque." FontSize="11" TextColor="Gray" Margin="0,0,0,15"/>
                        <CollectionView ItemsSource="{Binding OrigemEntradas}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="80, *, Auto" ColumnSpacing="10" Margin="0,2">
                                        <Label Grid.Column="0" Text="{Binding Nome}" TextColor="Black" VerticalOptions="Center" FontSize="13"/>
                                        <ProgressBar Grid.Column="1" Progress="{Binding PorcentagemBarra}" ProgressColor="#0A6FB5" VerticalOptions="Center"/>
                                        <Label Grid.Column="2" Text="{Binding Valor}" TextColor="Black" VerticalOptions="Center" FontSize="13" FontAttributes="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <Label Text="Doações enviadas a outras instituições" FontSize="16" TextColor="Gray" Margin="0,15,0,0"/>

            <Border BackgroundColor="White" Stroke="LightGray" StrokeShape="RoundRectangle 3" Padding="20">
                <Grid RowDefinitions="Auto, *" RowSpacing="10">
                    <Grid ColumnDefinitions="100, *, 80, *" ColumnSpacing="10" Padding="0,0,0,10">
                        <Label Grid.Column="0" Text="Data" FontAttributes="Bold" TextColor="Black" FontSize="13"/>
                        <Label Grid.Column="1" Text="Item" FontAttributes="Bold" TextColor="Black" FontSize="13"/>
                        <Label Grid.Column="2" Text="Qtd" FontAttributes="Bold" TextColor="Black" FontSize="13"/>
                        <Label Grid.Column="3" Text="Destino" FontAttributes="Bold" TextColor="Black" FontSize="13"/>
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding DoacoesEnviadas}">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhuma doação registrada." TextColor="Gray" Margin="0,10"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="100, *, 80, *" ColumnSpacing="10" Padding="0,5">
                                    <Label Grid.Column="0" Text="{Binding Data, StringFormat='{0:dd/MM/yyyy}'}" TextColor="Black" FontSize="13"/>
                                    <Label Grid.Column="1" Text="{Binding Item}" TextColor="Black" FontSize="13"/>
                                    <Label Grid.Column="2" Text="{Binding Quantidade}" TextColor="Black" FontSize="13"/>
                                    <Label Grid.Column="3" Text="{Binding Destino}" TextColor="Black" FontSize="13"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>