<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstoqueAsilo.MenuLateral"
             BackgroundColor="#0082db">
    <Grid RowDefinitions="Auto, *, Auto"
                         Padding="20"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill">
        
        <VerticalStackLayout Grid.Row="1" 
                             Spacing="20" 
                             Padding="0">
            <Button
            Grid.Row="1"
            Text="🏠​ Inicio"
            Command="{Binding SelecionarItemCommand}"
            CommandParameter="inicio"
            TextColor="White"
            BackgroundColor="#33FFFFFF"
            CornerRadius="8"
            Padding="15,10"
            HorizontalOptions="Fill"
            ContentLayout="15,0"/>

            <Label Text="REGISTRAR"
            TextColor="#A0C8E8"
            FontSize="12"
            FontAttributes="Bold"
            Margin="5,15,0,5"
            HorizontalOptions="Center"/>

            <Button
            Grid.Row="1"
            Text="🚪​ Entrada"
            Command="{Binding SelecionarItemCommand}"
            CommandParameter="entrada"
            TextColor="White"
            BackgroundColor="#33FFFFFF"
            HorizontalOptions="Fill"/>
        <Button
            Grid.Row="1"
            x:Name="Saida1"
            Text="🚪​ Saida"
            Command="{Binding SelecionarItemCommand}"
            CommandParameter="saida"
            TextColor="White"
            BackgroundColor="#33FFFFFF"
            HorizontalOptions="Fill"/>

            <Label Text="ESTOQUE"
           TextColor="#A0C8E8"
           FontSize="12"
           FontAttributes="Bold"
           Margin="5,15,0,5"
           HorizontalOptions="Center"/>

            <Button
            Grid.Row="1"
            x:Name="Estoque1"
            Text="​📦​ Estoque"
            Command="{Binding SelecionarItemCommand}"
            CommandParameter="estoque"
            TextColor="White"
            BackgroundColor="#33FFFFFF"
            HorizontalOptions="Fill"/>
        </VerticalStackLayout>
        
        <Button
            Grid.Row="2"
            x:Name="Sair1"
            Text="Sair do sistema"
            Clicked="Sair1_Clicked"
            TextColor="White"
            BackgroundColor="Red"
            HorizontalOptions="Fill"/>
    </Grid>
      
</ContentView>
