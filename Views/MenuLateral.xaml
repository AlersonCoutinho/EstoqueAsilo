<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstoqueAsilo.MenuLateral"
             BackgroundColor="#0082db">
    <Grid RowDefinitions="Auto, *, Auto"
                         Padding="20"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill">
        
        <VerticalStackLayout Grid.Row="1" 
                             Spacing="40" 
                             Padding="0">
            <Button
            Grid.Row="1"
            x:Name="inicio1"
            Text="🏠​ Inicio"
            Command="{Binding SelecionarItemCommand}"
            CommandParameter="inicio"
            TextColor="White"
            BackgroundColor="Transparent"
            HorizontalOptions="Start"/>
        <Button
            Grid.Row="1"
            x:Name="Entrada1"
            Text="🚪​ Entrada"
            Command="{Binding SelecionarItemCommand}"
            CommandParameter="entrada"
            TextColor="White"
            BackgroundColor="Transparent"
            HorizontalOptions="Start"/>
        <Button
            Grid.Row="1"
            x:Name="Saida1"
            Text="🚪​ Saida"
            Command="{Binding SelecionarItemCommand}"
            CommandParameter="saida"
            TextColor="White"
            BackgroundColor="Transparent"
            HorizontalOptions="Start"/>
        <Button
            Grid.Row="1"
            x:Name="Estoque1"
            Text="​📦​ Estoque"
            Command="{Binding SelecionarItemCommand}"
            CommandParameter="estoque"
            TextColor="White"
            BackgroundColor="Transparent"
            HorizontalOptions="Start"/>
        </VerticalStackLayout>
        
        <Button
            Grid.Row="2"
            x:Name="Sair1"
            Text="Sair do sistema"
            Clicked="Sair1_Clicked"
            TextColor="White"
            BackgroundColor="Red"
            HorizontalOptions="Fill"/>
    </Grid>
      
</ContentView>
