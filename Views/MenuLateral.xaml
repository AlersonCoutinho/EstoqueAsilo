<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstoqueAsilo.MenuLateral"
             BackgroundColor="#0082db">
    <ContentView.Resources>
        <Style x:Key="MenuItemBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#33FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="MenuItemText" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="MenuSeparator" TargetType="Label">
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="15,15,0,5" />
            <Setter Property="HorizontalOptions" Value="Start" />
        </Style>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto, *, Auto" Padding="10" HorizontalOptions="Fill" VerticalOptions="Fill">

        <VerticalStackLayout Grid.Row="1" Spacing="0">
            <Border Style="{StaticResource MenuItemBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelecionarItemCommand}" CommandParameter="inicio" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15">
                    <Image Source="casa.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Label Text="Início" Style="{StaticResource MenuItemText}" />
                </HorizontalStackLayout>
            </Border>

            <Label Text="Registrar" Style="{StaticResource MenuSeparator}" />

            <Border Style="{StaticResource MenuItemBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelecionarItemCommand}" CommandParameter="entrada" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15">
                    <Image Source="entrada.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Label Text="Entrada" Style="{StaticResource MenuItemText}" />
                </HorizontalStackLayout>
            </Border>

            <Border Style="{StaticResource MenuItemBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelecionarItemCommand}" CommandParameter="saida" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15">
                    <Image Source="saida.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Label Text="Saída" Style="{StaticResource MenuItemText}" />
                </HorizontalStackLayout>
            </Border>

            <Label Text="Ver estoque" Style="{StaticResource MenuSeparator}" />

            <Border Style="{StaticResource MenuItemBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelecionarItemCommand}" CommandParameter="estoque_alimentos" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15">
                    <Image Source="despensa.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Label Text="Despensa" Style="{StaticResource MenuItemText}" />
                </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource MenuItemBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelecionarItemCommand}" CommandParameter="estoque_almoxarifado" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15">
                    <Image Source="almoxarifado.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Label Text="Almoxarifado" Style="{StaticResource MenuItemText}" />
                </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource MenuItemBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelecionarItemCommand}" CommandParameter="estoque_limpeza" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15">
                    <Image Source="limpeza.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Label Text="Limpeza" Style="{StaticResource MenuItemText}" />
                </HorizontalStackLayout>
            </Border>

            <Label Text="Mais" Style="{StaticResource MenuSeparator}" />

            <Border Style="{StaticResource MenuItemBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelecionarItemCommand}" CommandParameter="relatorios" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15">
                    <Image Source="relatorio.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Label Text="Relatórios" Style="{StaticResource MenuItemText}" />
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
        <Border Grid.Row="2" Style="{StaticResource BotaoAcaoVermelho}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="Sair1_Clicked" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                <Image Source="desligar.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                <Label Text="Sair do Sistema" TextColor="White" FontSize="15" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentView>