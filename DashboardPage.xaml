<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:protótipo_acelera"
             x:Class="protótipo_acelera.DashboardPage"
             Title="DashboardPage"
             Shell.NavBarIsVisible="False">
    <Grid ColumnDefinitions="200, *">
        <local:MenuLateral x:Name="MenuLateralControl" Grid.Column="0"/>
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <local:BarraSuperior Grid.Row="0"/>
            <ContentView x:Name="AreaConteudo" Grid.Row="1" />
        </Grid>
    </Grid>
</ContentPage>